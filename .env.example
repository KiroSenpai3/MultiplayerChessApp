# Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache Settings
# If MONGODB_URI is left blank or unreachable, server uses in-memory DB for seamless demo/test
MONGODB_URI=mongodb://127.0.0.1:27017/multchess

# If REDIS_URL is left blank or unreachable, server uses in-memory mock Redis for seamless demo/test
REDIS_URL=redis://127.0.0.1:6379

# Matchmaking & Game Configuration
MATCHMAKING_POLL_INTERVAL_MS=1000
RECONNECT_WINDOW_SECONDS=30
LOG_LEVEL=info
